            }else if(dockername == 'identitymanagementapi'){
              sh "kubectl apply -f deploymentcetidentitymanagmentapi.yaml"
            }else if (dockername == 'moodle'){
              sh "kubectl apply -f moodledeployment.yaml"
            }else if (dockername == 'itestai'){
              sh "kubectl apply -f itestaideployment.yaml"
            }else if (dockername == 'infinity'){
              sh "kubectl apply -f infinitydeployment.yaml"
            }else if (dockername == 'infinityapi'){
              sh "kubectl apply -f infinitydeploymentapi.yaml"
            }else{    
              sh "kubectl apply -f deployment.yaml"
            } 
        }
      }
    } 
  }
  post{
    always {
      script{
         if (params.Deploy == 'Yes'){
            setBuildDescriptionDeploy (nairobiservicename, pushService, pushVersion)  
         }else{
           // Check if VERSION exists before using it
           if (binding.hasVariable('VERSION')) {
             setBuildDescription (nairobiservicename, PushBRANCH, VERSION, binding.hasVariable('dockername') ? dockername : "unknown")
           } else {
             setBuildDescription (nairobiservicename, PushBRANCH, "unknown", binding.hasVariable('dockername') ? dockername : "unknown")
           }
         } 
      } 
    }

    success {
      script{
        if (status == 'active') {    
            withCredentials([string(credentialsId: 'az_devops_personal_access_token', variable: 'TOKEN')]){
            env.AZURE_DEVOPS_EXT_PAT = "$TOKEN"
            sh "az repos pr set-vote --id ${pullRequestId} --vote approve"
              if(nairobiservicename == 'HendrXPoc' || nairobiservicename == 'collaboration'){
                  echo "skiping description"
              }else{
                  sh "az repos pr update --id ${pullRequestId} --description 'Image: ${IMAGE}:${VERSION}' 'Build: ${BUILD_URL}'>/dev/null"
              }
            }
        } else {        
          return
        }
      }    
    }
    failure {
      script {
        if (params.DISABLE_NOTIFICATION) {
            println "failure"
        } else {
          if (status == 'active'){ 
            withCredentials([string(credentialsId: 'az_devops_personal_access_token', variable: 'TOKEN')]){
            env.AZURE_DEVOPS_EXT_PAT = "$TOKEN"
            sh "az repos pr set-vote --id ${pullRequestId} --vote reject"
            }
          }else {
            return
          }
          global_sendEmailNotification to: developerEmail, subject: "${JOB_NAME} - Failed", body: "BUILD URL: ${BUILD_URL}"
        }			
      }
    }
  }      
} 
def setBuildDescription (nairobiservicename, branch, version, container) {
  def safeDockername = binding.hasVariable('dockername') ? dockername : container
  currentBuild.description = "nairobiservicename: ${nairobiservicename}\nbranch: ${branch}\nversion: ${version}\ncontainer: ${safeDockername}"
} 
def setBuildDescriptionDeploy (nairobiservicename, dockername, version) {
  currentBuild.description = "nairobiservicename: ${nairobiservicename}\nservicename: ${pushService}\nversion: ${pushVersion}"
}


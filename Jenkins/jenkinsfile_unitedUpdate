def setBuildDescription (SERVICE_NAME, NEW_IMAGE_TAG, ENV, chartVersion) {
  currentBuild.description = "SERVICE_NAME: ${SERVICE_NAME}\nNEW_IMAGE_TAG: ${NEW_IMAGE_TAG}\nENV: ${ENV}\nChart Version: ${chartVersion}"                 
}
def setBuildDescriptionNoChart (SERVICE_NAME, NEW_IMAGE_TAG, ENV) {
  currentBuild.description = "SERVICE_NAME: ${SERVICE_NAME}\nNEW_IMAGE_TAG: ${NEW_IMAGE_TAG}\nENV: ${ENV}"                 
}
def globalversionBump(Map config = [:]) {
  currentVersion   = config.get('currentVersion')  
  versionBumpType     = config.get('versionBumpType')   

  // Split the current version into major, minor, and patch components
  def (major, minor, patch) = currentVersion.tokenize('.').collect { it.toInteger() }

  switch (versionBumpType) {
  case 'patch':
      patch += 1
      break
  case 'minor':
      minor += 1
      patch = 0
      break
  case 'major':
      major += 1
      minor = 0
      patch = 0
      break
  default:
      println "Invalid bump_type. Expected 'patch', 'minor', or 'major'."
  }

  newVersion = "${major}.${minor}.${patch}"
  return newVersion        
}
